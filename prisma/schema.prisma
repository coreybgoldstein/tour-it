// ============================================================
// Tour It — Production Prisma Schema
// PostgreSQL | Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TeeColor {
  BLACK
  BLUE
  WHITE
  GOLD
  RED
  GREEN
  CUSTOM
}

enum CourseType {
  PUBLIC
  PRIVATE
  SEMI_PRIVATE
}

enum MediaType {
  VIDEO
  PHOTO
}

enum ShotType {
  TEE_SHOT
  APPROACH
  LAY_UP
  CHIP
  PITCH
  PUTT
  BUNKER
  RECOVERY
  FULL_HOLE
  FLYOVER
  FRONT_NINE
  BACK_NINE
  FULL_ROUND
  THREE_HOLE
}

enum LieType {
  FAIRWAY
  ROUGH
  BUNKER
  HARDPAN
  PINE_STRAW
  NATIVE
  TEE_BOX
  GREEN
}

enum WindCondition {
  CALM
  LIGHT
  MODERATE
  STRONG
  INTO
  DOWNWIND
  LEFT_TO_RIGHT
  RIGHT_TO_LEFT
}

enum HandicapRange {
  SCRATCH
  LOW
  MID
  HIGH
  BOGEY
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ReportReason {
  INAPPROPRIATE
  SPAM
  WRONG_HOLE
  WRONG_COURSE
  LOW_QUALITY
  COPYRIGHT
  OTHER
}

enum FollowStatus {
  ACTIVE
  BLOCKED
}

enum RankTier {
  CADDIE
  LOCAL
  MARSHAL
  COURSE_PRO
  TOUR_PRO
  LEGEND
}

enum BadgeCategory {
  CONTRIBUTION
  SOCIAL
  EXPLORER
  ACHIEVEMENT
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum ReferralStatus {
  PENDING
  SIGNED_UP
  FIRST_UPLOAD
  VOID
}

// CourseClaim status — the claim's lifecycle, not the course's claim
// state. Course.isClaimed flips true on the first VERIFIED claim.
enum CourseClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ============================================================
// USER
// ============================================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  username         String   @unique
  displayName      String
  firstName        String?
  lastName         String?
  avatarUrl        String?
  bannerUrl        String?
  bio              String?
  handicapIndex    Float?
  ghinNumber       String?
  homeCourseId     String?
  pushSubscription String?
  isVerified       Boolean  @default(false)
  isAdmin          Boolean  @default(false)
  uploadCount      Int      @default(0)
  reputationScore  Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploads             Upload[]
  rounds              Round[]
  uploadPhotos        UploadPhoto[]
  comments            Comment[]
  likes               Like[]
  saves               Save[]
  views               View[]
  reports             ModerationReport[]   @relation("ReportedBy")
  receivedReports     ModerationReport[]   @relation("ReportedUser")
  followers           Follow[]             @relation("Following")
  following           Follow[]             @relation("Follower")
  homeCourse          Course?              @relation("HomeCourse", fields: [homeCourseId], references: [id])
  createdTrips        GolfTrip[]           @relation("CreatedTrips")
  tripMemberships     GolfTripMember[]     @relation("TripMemberships")
  ryderAssignments    GolfTripRyderTeam[]
  tripMessages        TripMessage[]
  tripNotes           GolfTripNote[]
  createdTripGames    TripGame[]
  notifications       Notification[]
  uploadTags          UploadTag[]
  progression         UserProgression?
  pointsLedger        UserPointsLedger[]
  badges              UserBadge[]
  courseContributions CourseContribution[]
  invitesSent         Referral[]           @relation("InvitesSent")
  inviteReceived      Referral?            @relation("InvitesReceived")
  courseClaims        CourseClaim[]
  courseManagerships  CourseManager[]

  @@index([username])
  @@index([email])
  @@index([reputationScore(sort: Desc)])
}

// ============================================================
// COURSE
// ============================================================

model Course {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  city              String
  state             String
  country           String      @default("US")
  latitude          Float?
  longitude         Float?
  websiteUrl        String?
  phone             String?
  description       String?
  holeCount         Int         @default(18)
  /// Admin-only moderation flag — set false to hide a record from all listings (e.g. duplicates). NOT the course access type; use `courseType` for PUBLIC/SEMI_PRIVATE/PRIVATE.
  isPublic          Boolean     @default(true)
  courseType        CourseType?
  zipCode           String?
  yearEstablished   Int?
  isVerified        Boolean     @default(false)
  coverImageUrl     String?
  logoUrl           String?
  scorecardImageUrl String?
  searchVector      String?
  uploadCount       Int         @default(0)
  saveCount         Int         @default(0)
  viewCount         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // ── Course ownership (operator) layer ──────────────────────────
  // Distinct from `isVerified` (data-quality / admin flag) and from
  // the UGC `description` (golfer-contributed copy tracked by
  // CourseFieldContribution). Flips true on the first VERIFIED
  // CourseClaim.
  isClaimed           Boolean @default(false)
  // Operator-authored description. Course header prefers this over
  // `description` ONLY when isClaimed=true; the UGC description
  // stays the source of truth on unclaimed courses.
  officialDescription String?
  // Operator-supplied booking link rendered in the "From the
  // course" block as a "Book a tee time" button. Reuses the
  // existing `websiteUrl` field for the course homepage.
  // NOTE 2026-05-30: hidden from the manage dashboard for now per
  // product decision (booking partnerships are a separate roadmap
  // item). API + render path are kept so flipping it back on is
  // a one-line change.
  teeSheetUrl         String?
  // Operator-supplied membership inquiry link — surfaced only on
  // PRIVATE courses since public/semi-private courses use the
  // booking flow instead. Renders as "Inquire about membership"
  // inside the "From the course" block when set.
  membershipInquiryUrl String?

  holes          Hole[]
  saves          Save[]
  views          View[]
  homeUsers      User[]                @relation("HomeCourse")
  teeBoxes       TeeBox[]
  itineraryStops TripItineraryStop[]
  claims         CourseClaim[]
  managers       CourseManager[]
  staff          CourseStaff[]
  officialMedia  CourseOfficialMedia[]

  @@index([state])
  @@index([city, state])
  @@index([slug])
  @@index([isPublic])
  @@index([uploadCount(sort: Desc)])
}

// ============================================================
// HOLE
// ============================================================

model Hole {
  id           String   @id @default(cuid())
  courseId     String
  holeNumber   Int
  par          Int
  handicapRank Int?
  description  String?
  imageUrl     String?
  uploadCount  Int      @default(0)
  yardage      Int?
  teeLat       Float?
  teeLng       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teeBoxes TeeBox[]
  uploads  Upload[]

  @@unique([courseId, holeNumber])
  @@index([courseId])
  @@index([holeNumber])
}

// ============================================================
// TEE BOX
// ============================================================

model TeeBox {
  id          String   @id @default(cuid())
  courseId    String
  holeId      String
  color       TeeColor
  customLabel String?
  yardage     Int
  rating      Float?
  slope       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  hole    Hole     @relation(fields: [holeId], references: [id], onDelete: Cascade)
  uploads Upload[]

  @@unique([holeId, color])
  @@index([holeId])
  @@index([courseId])
}

// ============================================================
// UPLOAD
// ============================================================

model Upload {
  id               String  @id @default(cuid())
  // The current owner of this clip — appears on their profile, gets points
  // for engagement. May change when a hero tag is approved (transfer from
  // uploader -> hero). Always a real user id.
  userId           String
  // The ORIGINAL uploader of this clip, set only when ownership has been
  // transferred via an approved hero tag. NULL means the current userId
  // is also the uploader (no transfer ever happened). Used to render the
  // small "uploaded by @user" attribution chip on the clip.
  uploadedByUserId String?
  courseId         String
  holeId           String
  teeBoxId         String?

  mediaType         MediaType
  mediaUrl          String
  cloudflareVideoId String?
  thumbnailUrl      String?
  durationSeconds   Int?
  fileSizeBytes     BigInt?
  resolution        String?

  shotType             ShotType?
  clubUsed             String?
  distancePlayed       Int?
  windCondition        WindCondition?
  conditions           String?
  lieType              LieType?
  handicapRange        HandicapRange?
  strategyNote         String?
  landingZoneNote      String?
  whatCameraDoesntShow String?
  datePlayedAt         DateTime?

  caption        String?
  seriesId       String?
  seriesOrder    Int?
  yardageOverlay String?
  tripId         String?
  tripPublic     Boolean @default(true)

  clipLat Float?
  clipLng Float?

  likeCount           Int    @default(0)
  commentCount        Int    @default(0)
  viewCount           Int    @default(0)
  saveCount           Int    @default(0)
  watchCompletionRate Float?
  rankScore           Float  @default(0)

  moderationStatus ModerationStatus @default(PENDING)
  moderatedAt      DateTime?
  moderatedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roundId String?

  user     User               @relation(fields: [userId], references: [id])
  hole     Hole               @relation(fields: [holeId], references: [id])
  teeBox   TeeBox?            @relation(fields: [teeBoxId], references: [id])
  round    Round?             @relation(fields: [roundId], references: [id])
  photos   UploadPhoto[]
  comments Comment[]
  likes    Like[]
  views    View[]
  reports  ModerationReport[]

  @@index([holeId])
  @@index([courseId])
  @@index([userId])
  @@index([holeId, rankScore(sort: Desc)])
  @@index([holeId, teeBoxId, rankScore(sort: Desc)])
  @@index([moderationStatus])
  @@index([createdAt(sort: Desc)])
  @@index([seriesId])
}

// ============================================================
// ROUND
// ============================================================

model Round {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  date        String
  totalScore  Int?
  fairwaysHit Int?
  putts       Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Links the score ledger to the shared trip/round container so clips,
  // games, and head-to-head all line up on one course+date.
  golfTripId  String?
  tripGameId  String?

  // Scorecard / GHIN ingestion fields. holeScores is an Int[] of gross
  // strokes by hole (index 0 = hole 1); null entries allowed for blanks.
  // source distinguishes how the round was filled.
  teeColor         String?
  courseRating     Float?
  slope            Int?
  scoreToPar       Int?
  greensInReg      Int?
  fairwaysPossible Int?
  holeScores       Json?
  source           String? // "ghin" | "scorecard" | "manual"

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  golfTrip GolfTrip? @relation(fields: [golfTripId], references: [id], onDelete: SetNull)
  uploads  Upload[]

  @@index([userId])
  @@index([courseId])
  @@index([golfTripId])
}

// ============================================================
// UPLOAD PHOTO
// ============================================================

model UploadPhoto {
  id        String   @id @default(cuid())
  uploadId  String
  userId    String
  photoUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([uploadId])
}

// ============================================================
// COMMENT
// ============================================================

model Comment {
  id        String   @id @default(cuid())
  uploadId  String
  userId    String
  body      String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  likes  Like[]

  @@index([uploadId, createdAt(sort: Desc)])
  @@index([userId])
}

// ============================================================
// LIKE
// ============================================================

model Like {
  id        String   @id @default(cuid())
  userId    String
  uploadId  String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  upload  Upload?  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, uploadId])
  @@unique([userId, commentId])
  @@index([uploadId])
  @@index([userId])
}

// ============================================================
// SAVE
// ============================================================

model Save {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?
  uploadId  String?
  saveType  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@unique([userId, uploadId])
  @@index([userId])
  @@index([courseId])
}

// ============================================================
// VIEW
// ============================================================

model View {
  id        String   @id @default(cuid())
  userId    String?
  uploadId  String?
  courseId  String?
  sessionId String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([uploadId, createdAt(sort: Desc)])
  @@index([courseId, createdAt(sort: Desc)])
  @@index([userId])
}

// ============================================================
// FOLLOW
// ============================================================

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id])
  following User @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================================
// MODERATION REPORT
// ============================================================

model ModerationReport {
  id             String           @id @default(cuid())
  reportedById   String
  reportedUserId String?
  uploadId       String?
  reason         ReportReason
  notes          String?
  status         ModerationStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime         @default(now())

  reportedBy   User    @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedUser User?   @relation("ReportedUser", fields: [reportedUserId], references: [id])
  upload       Upload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([uploadId])
  @@index([reportedById])
}

// ============================================================
// GOLF TRIPS
// ============================================================

model GolfTrip {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   String?
  endDate     String?
  imageUrl    String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Logistics — captured at trip creation so the trip is useful from
  // day 1 (and so public conversion has real airport + lodging detail).
  arrivalAirport String?
  lodging        String?
  // Structured lodging location — captured when the user picks a
  // result from the LodgingField dropdown (Nominatim returns city +
  // state alongside the display name). Used as the top-priority
  // source for the home-screen "Your Tour" location chip — beats the
  // airport's city, which often misleads (TVC = Traverse City but
  // the user is actually in Boyne / Harbor Springs).
  // Null when the lodging was typed freehand; we fall back to the
  // raw lodging string in that case.
  lodgingCity    String?
  lodgingState   String?

  // Public conversion. When the user opts to publish, isPublic flips
  // true and publicizedAt is set; we also create a TripItinerary row
  // referencing this trip via sourceGolfTripId.
  // publicizeNotifiedAt is set by the day-after cron so we don't
  // re-prompt the user on every cron run.
  isPublic            Boolean   @default(false)
  publicizedAt        DateTime?
  publicizeNotifiedAt DateTime?

  // Ryder Cup mode
  ryderCupEnabled Boolean @default(false)
  redTeamName     String?
  blueTeamName    String?
  redTeamScore    Float   @default(0)
  blueTeamScore   Float   @default(0)

  creator    User                @relation("CreatedTrips", fields: [createdBy], references: [id])
  courses    GolfTripCourse[]
  members    GolfTripMember[]
  messages   TripMessage[]
  games      TripGame[]
  ryderTeams GolfTripRyderTeam[]
  notes      GolfTripNote[]
  rounds     Round[]

  @@index([createdBy])
  @@index([endDate, isPublic, publicizeNotifiedAt])
}

// User-authored notes attached to a trip — surfaced as a knowledge
// layer ("best clubhouses", "weather notes", "best food") that
// every trip member contributes to. Visible to all members; visible
// to everyone if the trip gets publicized.
model GolfTripNote {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  category  String // "clubhouse" | "food" | "weather" | "tip" | "logistics" | "course" | "other"
  subject   String? // optional title — e.g. restaurant name, course nickname
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip GolfTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, category, createdAt(sort: Desc)])
  @@index([userId])
}

model GolfTripRyderTeam {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  team      String // "RED" | "BLUE"
  createdAt DateTime @default(now())

  trip GolfTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

model GolfTripCourse {
  id                String   @id @default(cuid())
  tripId            String
  courseId          String
  // Paired 9+9 round: when set, this stop plays as 18 holes — front 9 from
  // courseId, back 9 from secondaryCourseId. Both courses must be holeCount=9.
  secondaryCourseId String?
  playDate          String?
  teeTime           String?
  accommodation     String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  trip GolfTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model GolfTripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String   @default("member")
  // Invite gating: "accepted" shows the trip/game/round in the member's
  // lists + profile; "pending" hides it until they accept the invite
  // notification. Defaulting to "accepted" backfills every existing row
  // (and keeps trip creators visible). New non-creator invitees are
  // inserted as "pending". Declining deletes the row entirely.
  status    String   @default("accepted")
  createdAt DateTime @default(now())

  trip GolfTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User     @relation("TripMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

model TripMessage {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  trip GolfTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt(sort: Asc)])
}

model TripGame {
  id            String   @id @default(cuid())
  tripId        String
  courseId      String
  courseName    String
  format        String
  formatConfig  Json
  players       Json
  holeHandicaps Json?
  gameSheet     String
  shareText     String
  // Per-player hole-by-hole gross scores entered after play, including
  // guests not in the app. Shape: { [playerKey]: (number|null)[] } where
  // playerKey is the userId when matched, else the player's display name.
  scores        Json?
  // Settled result the user confirmed: proposed winners + net $ breakdown
  // per format segment. Null until scores are entered and settlement is
  // confirmed.
  settlement    Json?
  createdBy     String
  createdAt     DateTime @default(now())

  trip    GolfTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator User     @relation(fields: [createdBy], references: [id])

  @@index([tripId, createdAt(sort: Desc)])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String
  linkUrl     String?
  referenceId String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================
// SEARCH LOG
// ============================================================

// Idempotent cache for the AI trip planner. Keyed on a SHA-256 of the
// canonical brief inputs (group, budget, months, vibes, notes, origin)
// so two users with identical briefs share the Claude call. 7-day TTL
// so newly-added itineraries propagate within a week.
model TripPlannerCache {
  briefHash String   @id
  brief     Json?
  response  Json
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([hits(sort: Desc)])
}

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  params      Json?
  resultIds   String[]
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  clicks SearchClick[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model SearchClick {
  id          String   @id @default(cuid())
  searchLogId String
  courseId    String
  courseName  String
  position    Int
  userId      String?
  createdAt   DateTime @default(now())

  searchLog SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@index([searchLogId])
  @@index([courseId])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// UPLOAD TAG
// ============================================================

model UploadTag {
  id        String   @id @default(cuid())
  uploadId  String
  userId    String
  // null = pending, true = approved (on-profile), false = declined
  approved  Boolean?
  // When true, an approval also transfers Upload.userId to this user
  // (ownership handoff for "you filmed me hitting this shot" flow).
  // Multiple co-star (isHero=false) tags allowed per upload; only one
  // hero tag enforced by the upload UI (no DB-level constraint).
  isHero    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([uploadId, userId])
  @@index([uploadId])
  @@index([userId])
}

// ============================================================
// PROGRESSION SYSTEM
// ============================================================

model UserProgression {
  id            String    @id @default(cuid())
  userId        String    @unique
  totalPoints   Int       @default(0)
  level         Int       @default(1)
  rank          RankTier  @default(CADDIE)
  weeklyPoints  Int       @default(0)
  monthlyPoints Int       @default(0)
  streakWeeks   Int       @default(0)
  heroBadgeIds  Json?
  weekReset     DateTime?
  monthReset    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints(sort: Desc)])
  @@index([weeklyPoints(sort: Desc)])
  @@index([monthlyPoints(sort: Desc)])
}

model UserPointsLedger {
  id          String   @id @default(cuid())
  userId      String
  action      String
  points      Int
  referenceId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
}

model Badge {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  iconUrl     String?
  category    BadgeCategory
  rarity      BadgeRarity
  pointValue  Int           @default(0)
  requirement Json
  createdAt   DateTime      @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model CourseContribution {
  id            String    @id @default(cuid())
  userId        String
  courseId      String
  uploadCount   Int       @default(0)
  firstUploadAt DateTime?
  lastUploadAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, uploadCount(sort: Desc)])
  @@index([userId])
}

model CourseFieldContribution {
  id        String   @id @default(cuid())
  courseId  String
  fieldName String
  userId    String
  awardedAt DateTime @default(now())

  @@unique([courseId, fieldName])
  @@index([userId])
  @@index([courseId])
}

model LeaderboardSnapshot {
  id          String            @id @default(cuid())
  period      LeaderboardPeriod
  periodStart DateTime
  periodEnd   DateTime
  userId      String
  rank        Int
  points      Int
  level       Int
  createdAt   DateTime          @default(now())

  @@index([period, periodStart])
  @@index([userId])
}

model RewardsWaitlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String
  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ============================================================
// REFERRALS
// ============================================================

model Referral {
  id                    String         @id @default(cuid())
  inviterId             String
  inviteeId             String?        @unique
  inviteeUsername       String?
  status                ReferralStatus @default(PENDING)
  signupAt              DateTime?
  firstUploadAt         DateTime?
  signupPointsAwardedAt DateTime?
  uploadPointsAwardedAt DateTime?
  ipAddressAtSignup     String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  inviter User  @relation("InvitesSent", fields: [inviterId], references: [id])
  invitee User? @relation("InvitesReceived", fields: [inviteeId], references: [id])

  @@index([inviterId])
}

model CourseRequest {
  id         String      @id @default(cuid())
  userId     String
  name       String
  city       String
  state      String
  courseType CourseType?
  websiteUrl String?
  notes      String?
  status     String      @default("PENDING")
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([status, createdAt(sort: Desc)])
}

// ============================================================
// TRIP ITINERARIES — curated golf trips for the dart-throw feature
// ============================================================

model TripItinerary {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  tagline         String
  whyThisTrip     String  @db.Text
  heroImageUrl    String?
  vibeTag         String
  costBand        String
  bestSeasonStart Int
  bestSeasonEnd   Int
  durationDays    Int
  stayRec         String
  latitude        Float
  longitude       Float
  region          String
  dartThrowCount  Int     @default(0)

  // User-submitted itineraries. When a GolfTrip is publicized, we
  // create a TripItinerary referencing it via sourceGolfTripId; the
  // UI shows a "Submitted by @username" credit chip at the top.
  // sourceGolfTripId is nullable so curated trips stay clean.
  sourceGolfTripId  String?
  submittedByUserId String?

  stops     TripItineraryStop[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([region])
  @@index([vibeTag])
}

model TripItineraryStop {
  id          String        @id @default(cuid())
  itineraryId String
  itinerary   TripItinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])
  day         Int
  order       Int           @default(1)
  note        String?

  @@unique([itineraryId, day, order])
  @@index([itineraryId])
  @@index([courseId])
}

// ============================================================
// COURSE OWNERSHIP / OPERATOR LAYER
// ============================================================
//
// A course operator (GM, head pro, marketing) claims a course; an
// admin verifies; once verified, one or more CourseManager rows
// authorize them to edit the official-info layer. The official
// layer (officialDescription, staff cards, official media, tee
// sheet) is rendered separately from golfer UGC — the two never
// collide in the swipe feed or compete for primacy.

model CourseClaim {
  id               String            @id @default(cuid())
  courseId         String
  userId           String
  status           CourseClaimStatus @default(PENDING)
  claimantName     String
  claimantRole     String // "Head PGA Professional", "GM", "Marketing Director", etc.
  claimantEmail    String // work email; admin uses domain match against course.websiteUrl as a verification hint
  verificationNote String?
  requestedAt      DateTime          @default(now())
  reviewedAt       DateTime?
  reviewedBy       String? // userId of the admin who actioned the claim

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@index([status, requestedAt(sort: Desc)])
}

// A verified operator's authorization to manage a course's official
// layer. Multiple managers per course allowed (a head pro AND a
// marketing director can both edit). Created automatically when an
// admin verifies a CourseClaim.
model CourseManager {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  role      String // mirrors CourseClaim.claimantRole at time of verification
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
}

// Staff cards rendered in the "From the course" block on a course
// page (PGA pros, GMs, etc.). Not feed items, not Uploads — these
// live entirely in the operator layer and are not part of the UGC
// scoring/rank pipeline.
model CourseStaff {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  role      String // "Head PGA Professional", "Director of Golf", etc.
  bio       String?
  photoUrl  String?
  email     String?
  phone     String?
  isPublic  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

// Course-managed media (hole flyovers, official photos) kept SEPARATE
// from the UGC Upload model. Never injected into the clip swipe feed
// — rendered only in the "From the course" block / hole detail
// page's official section.
model CourseOfficialMedia {
  id                String   @id @default(cuid())
  courseId          String
  // holeNumber is the START of the range when holeRangeEnd is set
  // (e.g. holeNumber=1 + holeRangeEnd=3 means "holes 1-3"), or the
  // single hole when holeRangeEnd is null. holeNumber=null +
  // holeRangeEnd=null = course-level (drone of the property, etc).
  holeNumber        Int?
  holeRangeEnd      Int? // inclusive end of a multi-hole range
  mediaType         String // "image" | "flyover" | "video"
  url               String
  cloudflareVideoId String? // for "flyover"/"video" — mirrors Upload.cloudflareVideoId so the same HLS playback path works
  caption           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, holeNumber, sortOrder])
}
